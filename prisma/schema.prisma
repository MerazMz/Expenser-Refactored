// Prisma Schema for Expenser (PostgreSQL)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?
  displayName     String?
  photoURL        String?
  provider        String    @default("email")
  resetOTP        String?
  resetOTPExpires DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  settings        Settings?
  accounts        Account[]
  expenses        Expense[]
  syncEvents      SyncEvent[]

  @@map("users")
}

model Account {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String    // e.g. "Daily Food Expenses", "Daily Savings"
  type           String    @default("budget") // "budget" (Fixed Daily Budget) or "flex" (Track As You Go)
  initialBalance Float     @default(0)
  monthlyBudget  Float     @default(0)
  dailyBudget    Float     @default(0)
  currency       String    @default("INR")
  color          String    @default("#10b981")
  icon           String    @default("wallet")
  isDefault      Boolean   @default(false)
  version        Int       @default(1)
  deletedAt      DateTime?
  expenses       Expense[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Settings {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyBudget Float
  dailyBudget   Float
  currency      String    @default("INR")
  currentMonth  String    // Format: YYYY-MM
  theme         String    @default("dark")
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("settings")
}

model Expense {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      String    // Format: YYYY-MM-DD
  limit     Float
  spent     Float     @default(0)
  saved     Float     @default(0)
  note      String    @default("")
  version   Int       @default(1)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, accountId, date])
  @@index([userId, accountId, date])
  @@index([userId, accountId])
  @@index([userId])
  @@map("expenses")
}

model SyncEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    Int      @default(autoincrement())
  entityType String   // "expense" | "account" | "settings"
  entityId   String
  operation  String   // "create" | "update" | "delete"
  data       Json
  createdAt  DateTime @default(now())

  @@index([userId, version])
  @@map("sync_events")
}
